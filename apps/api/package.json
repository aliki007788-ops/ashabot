{
  "name": "@bot-platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma db push && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:tsx": "tsx src/server.ts",
    "start:prod": "prisma db push --skip-generate && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:new": "node prisma/seed-new-clusters.cjs",
    "seed:all": "FORCE_SEED=1 node prisma/bootstrap.cjs",
    "dev:fast": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.27.3",
    "@fastify/cors": "10.1.0",
    "@fastify/helmet": "12.0.1",
    "@fastify/jwt": "9.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "dotenv": "16.6.1",
    "fastify": "5.12.5",
    "fastify-plugin": "5.1.0",
    "ioredis": "5.11.1",
    "openai": "4.104.0",
    "pino": "9.14.0",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "socket.io": "4.8.4",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}