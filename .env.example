# ===== Database =====
DATABASE_URL=postgresql://botuser:botpass@localhost:5432/botplatform?schema=public

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== API =====
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===== AI Providers =====
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
