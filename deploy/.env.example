# ===== آدرس سایت =====
# با دامنه:   DOMAIN=example.com        PUBLIC_URL=https://example.com
# فقط با IP:  DOMAIN=:80                PUBLIC_URL=http://1.2.3.4
DOMAIN=:80
PUBLIC_URL=http://YOUR_SERVER_IP

# ===== دیتابیس (یک رمز قوی و بدون کاراکتر خاص مثل @ : / بگذارید) =====
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== امنیت (هرکدام یک رشته تصادفی حداقل ۳۲ کاراکتر؛ با: openssl rand -hex 32) =====
JWT_ACCESS_SECRET=CHANGE_ME_64_RANDOM_CHARS_AAAAAAAAAAAAAAAAAAAAAAAAAAAA
JWT_REFRESH_SECRET=CHANGE_ME_64_RANDOM_CHARS_BBBBBBBBBBBBBBBBBBBBBBBBBBBB
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS_CCCCCCCCCCCCCCCCCCCCCCCCCCCC
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== هوش مصنوعی (حداقل یک کلید) =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.avalai.ir/v1
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ===== پرداخت زرین‌پال (اختیاری) =====
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=false
